{
    "name": "ssandir/trypatch",
    "version": "0.0.2",
    "description": "Production error investigation and automatic resolution with AI-powered diagnostics",
    "type": "module",
    "private": true,
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "scripts": {
        "build": "vite build",
        "build:dev": "vite build --watch",
        "test": "jest --passWithNoTests",
        "test:dev": "jest --watch",
        "lint": "eslint --max-warnings 0",
        "lint:fix": "eslint --max-warnings 0 --fix",
        "lint:inspect": "eslint --inspect-config",
        "type-check": "tsc --project tsconfig.json --pretty --noEmit && eslint src"
    },
    "dependencies": {
        "ajv": "^8.17.1",
        "flare-redact": "^1.6.1",
        "json-schema-to-ts": "^3.1.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.36.0",
        "@swc/core": "^1.13.3",
        "@swc/jest": "^0.2.39",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.5.1",
        "eslint": "^9.36.0",
        "eslint-plugin-jest": "^29.0.1",
        "globals": "^17.0.0",
        "jest": "^30.2.0",
        "jest-config": "^30.2.0",
        "jiti": "^2.7.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.0",
        "vite": "^8.3.0",
        "vite-plugin-dts": "^5.1.0"
    }
}
